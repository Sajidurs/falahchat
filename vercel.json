{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "redirects": [
    { "source": "/whatsapp", "destination": "/whatsapp-ai-agent", "permanent": true },
    { "source": "/instagram", "destination": "/instagram-ai-agent", "permanent": true },
    { "source": "/messenger", "destination": "/messenger-ai-agent", "permanent": true },
    { "source": "/website", "destination": "/website-chatbot", "permanent": true },
    { "source": "/book", "destination": "/contact", "permanent": false }
  ]
}
